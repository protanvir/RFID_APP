<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:paddingTop="@dimen/stack_md"
    android:paddingLeft="@dimen/margin_edge"
    android:paddingRight="@dimen/margin_edge"
    android:paddingBottom="@dimen/stack_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- RFID Power Level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rfid_power_level"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/base">

                <TextView
                    android:id="@+id/tv_power_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:textColor="@color/primary_container"
                    android:textSize="@dimen/data_lg_text_size"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dBm"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:layout_marginStart="@dimen/base"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_power_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/high_power"
                    android:textColor="@color/primary_container"
                    android:textSize="@dimen/label_caps_text_size"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:background="@color/surface_container_highest"
                    android:paddingLeft="@dimen/stack_sm"
                    android:paddingRight="@dimen/stack_sm"
                    android:paddingTop="@dimen/base"
                    android:paddingBottom="@dimen/base"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="26"
                android:layout_marginTop="@dimen/stack_sm"/>
        </LinearLayout>

        <!-- EPC Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/epc_prefix_filtering"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/label_caps_text_size"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_epc_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_epc_prefix"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="text"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/data_lg_text_size"
                android:hint="0xEE02"
                android:enabled="false"
                android:layout_marginTop="@dimen/stack_sm"/>
        </LinearLayout>

        <!-- Read options: signal filter + trigger mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimum signal (dBm, e.g. -65; blank = off)"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>

            <EditText
                android:id="@+id/et_min_rssi"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="numberSigned"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="off"
                android:layout_marginTop="@dimen/base"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hold trigger to scan (off = press to start/stop)"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/label_caps_text_size"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_trigger_hold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Platform Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_label"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <RadioGroup
                android:id="@+id/rg_platform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_platform_off"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/platform_off"
                    android:textColor="@color/on_surface"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rb_platform_wiclax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/platform_wiclax"
                    android:textColor="@color/on_surface"/>

                <RadioButton
                    android:id="@+id/rb_platform_rufus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/platform_rufus"
                    android:textColor="@color/on_surface"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Wiclax Config -->
        <LinearLayout
            android:id="@+id/wiclax_config_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/external_server_config"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/stack_sm">

                <TextView
                    android:id="@+id/tv_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot_red"
                    android:layout_marginEnd="@dimen/base"/>

                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Starting..."
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/body_lg_text_size"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_url"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="textUri"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="http://wiclax.com:35014"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_label"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_user"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="text"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="your_username"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_id"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_device_id"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="text"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="C72-SN-001"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_button_height"
                android:text="SAVE SETTINGS"
                android:textAllCaps="true"
                android:textSize="@dimen/body_lg_text_size"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_container"
                android:textColor="@color/zinc_950"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>

        <!-- Rufus Config -->
        <LinearLayout
            android:id="@+id/rufus_config_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rufus_config"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <!-- Rufus status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/stack_sm">

                <TextView
                    android:id="@+id/tv_rufus_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot_gray"
                    android:layout_marginEnd="@dimen/base"/>

                <TextView
                    android:id="@+id/tv_rufus_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rufus_ready"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/body_lg_text_size"/>
            </LinearLayout>

            <!-- API Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_key"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_rufus_api_key"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="textVisiblePassword"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="@string/rufus_api_key_hint"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <!-- DEVICE SN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_serial"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_rufus_serial"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="text"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="C72-SN-001"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <!-- ALIAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_alias"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_rufus_alias"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="text"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="My C72 Timer"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <Button
                android:id="@+id/btn_bind_rufus"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_button_height"
                android:text="@string/bind_device"
                android:textAllCaps="true"
                android:textSize="@dimen/body_lg_text_size"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_container"
                android:textColor="@color/zinc_950"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>

        <!-- Status / health -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <TextView
                android:id="@+id/tv_health"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <Button
                android:id="@+id/btn_check_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check clock now"
                android:textAllCaps="true"
                android:backgroundTint="@color/surface_container_highest"
                android:textColor="@color/primary_container"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>

        <!-- Bib list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bib list"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <TextView
                android:id="@+id/tv_bib_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:layout_marginBottom="@dimen/stack_sm"/>

            <Button
                android:id="@+id/btn_reload_bibs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reload bib list"
                android:textAllCaps="true"
                android:backgroundTint="@color/surface_container_highest"
                android:textColor="@color/primary_container"
                style="@style/Widget.Material3.Button"/>
        </LinearLayout>

        <!-- Data tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/zinc_900"
            android:padding="@dimen/gutter"
            android:layout_marginBottom="@dimen/stack_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data tools"
                android:textColor="@color/outline"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/base"/>

            <Button
                android:id="@+id/btn_resend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Re-send reads from today's log"
                android:textAllCaps="true"
                android:backgroundTint="@color/surface_container_highest"
                android:textColor="@color/primary_container"
                style="@style/Widget.Material3.Button"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_export_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/base"
                    android:text="Export settings"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/surface_container_highest"
                    android:textColor="@color/primary_container"
                    style="@style/Widget.Material3.Button"/>

                <Button
                    android:id="@+id/btn_import_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Import settings"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/surface_container_highest"
                    android:textColor="@color/primary_container"
                    style="@style/Widget.Material3.Button"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete read logs older than (days; blank = never)"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/label_caps_text_size"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="@dimen/stack_sm"
                android:layout_marginBottom="@dimen/base"/>

            <EditText
                android:id="@+id/et_keep_days"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:inputType="number"
                android:paddingLeft="@dimen/gutter"
                android:paddingRight="@dimen/gutter"
                android:background="@color/surface_container_lowest"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/body_lg_text_size"
                android:hint="never"/>
        </LinearLayout>

        <!-- Hardware Monitor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/stack_md">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/zinc_900"
                android:padding="@dimen/gutter"
                android:layout_marginEnd="@dimen/gutter">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/module_temp"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/label_caps_text_size"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_module_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/data_lg_text_size"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/celsius"
                        android:textColor="@color/zinc_500"
                        android:textSize="@dimen/label_caps_text_size"
                        android:layout_marginStart="@dimen/base"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/zinc_900"
                android:padding="@dimen/gutter">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_health"
                    android:textColor="@color/outline"
                    android:textSize="@dimen/label_caps_text_size"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tv_battery_health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/data_lg_text_size"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
